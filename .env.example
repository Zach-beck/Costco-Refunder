# Local mode needs no database, Redis, or object storage.
# Leave LOCAL_MODE=1 for the quickstart. Keys below are names only.
# Put real values in .env, which is gitignored. Never commit them.
LOCAL_MODE=1
DATA_DIR=./data

# Used only when LOCAL_MODE is off (Docker Postgres / Redis / MinIO).
# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receipt_rewind

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in dev, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=receipts
S3_REGION=us-east-1

# Auth
SESSION_SECRET=change-me-in-production
COOKIE_DOMAIN=localhost

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Frontend env (Vite requires VITE_ prefix for client-side access)
VITE_VAPID_PUBLIC_KEY=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=alerts@example.com

# App
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
NODE_ENV=development
PORT=3001
