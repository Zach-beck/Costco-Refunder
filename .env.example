# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/costco_refunder

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in dev, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=receipts
S3_REGION=us-east-1

# Auth
SESSION_SECRET=change-me-in-production
COOKIE_DOMAIN=localhost

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@costco-refunder.app

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=alerts@costco-refunder.app

# App
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
NODE_ENV=development
PORT=3001
